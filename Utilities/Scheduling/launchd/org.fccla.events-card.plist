<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Fires the events-card workflow on a clock that doesn't drop timers.

  Hourly at :47, on a minute nothing else here uses (:27 service, :37
  weather, :11/:26/:41/:56 rotation).

  Hourly rather than daily because this workflow also sends the "new event
  on the calendar" text, and daily meant that text could be a day behind.
  It costs almost nothing: an unchanged calendar skips the Gemini call, the
  Drive write and the state commit, leaving one scrape and a fingerprint
  comparison.

  Install: see README.md in this directory.
-->
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>org.fccla.events-card</string>
	<key>ProgramArguments</key>
	<array>
		<string>/usr/bin/python3</string>
		<string>/Users/soundteam/Tech-Info/Utilities/Scheduling/launchd/dispatch_workflow.py</string>
		<string>generate_events_ad.yml</string>
	</array>
	<key>RunAtLoad</key>
	<false/>
	<key>StandardErrorPath</key>
	<string>/Users/soundteam/Library/Logs/fccla-events-card.log</string>
	<key>StandardOutPath</key>
	<string>/Users/soundteam/Library/Logs/fccla-events-card.log</string>
	<key>StartCalendarInterval</key>
	<array>
		<dict>
			<key>Minute</key>
			<integer>47</integer>
		</dict>
	</array>
</dict>
</plist>
